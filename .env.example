# Copy this file to `.env` (git ignores `.env`) and fill in the values.

# Required. The local PostgreSQL started by `docker compose up -d`.
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research

# Optional. Without it, no traces are sent to Logfire (ticket 01 creates it).
LOGFIRE_TOKEN=

# Optional. Seconds the placeholder waits before each status change (default 2).
# PLACEHOLDER_STEP_SECONDS=2
